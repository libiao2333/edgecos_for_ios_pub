<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- 网络权限 -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- 投屏（DLNA/SSDP）：Wi-Fi 状态 + 组播锁 -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />

    <!-- 前台服务（上传/下载） -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />

    <!-- 通知（Android 13+） -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Android 16+ 实时活动（Live Updates / 流体云）：申请提升为常驻实时活动所需 -->
    <uses-permission android:name="android.permission.POST_PROMOTED_NOTIFICATIONS" />

    <!-- 生物锁 -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />

    <!-- 管理所有文件权限（网盘应用需要全文件访问 + 下载到公共目录，Android 11+） -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />

    <!-- 传统存储权限（Android 6.0~10 写公共下载目录所需；Android 11+ 改用 MANAGE_EXTERNAL_STORAGE，故限制 maxSdkVersion） -->
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="29" />

    <!-- 应用内更新：下载 APK 后拉起系统安装程序（Android 8.0+ 必需） -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <application
        android:name=".EdgeCOSApp"
        android:allowBackup="false"
        android:requestLegacyExternalStorage="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@drawable/ic_launcher_foreground"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@drawable/ic_launcher_foreground"
        android:supportsRtl="true"
        android:theme="@style/Theme.EdgeCOS"
        tools:targetApi="34"
        tools:replace="android:allowBackup">

        <!-- 主 Activity：启动器 + App Links 接收 -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:launchMode="singleTop"
            android:theme="@style/Theme.EdgeCOS.Splash">
            <!-- 启动器 -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- App Links：实名认证回调 -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="user.edgecos.com" android:pathPrefix="/realname/callback" />
            </intent-filter>
            <!-- App Links：支付成功回调 -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="user.edgecos.com" android:pathPrefix="/pay/success" />
            </intent-filter>
            <!-- App Links：分享链接 -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="user.edgecos.com" android:pathPrefix="/s/" />
            </intent-filter>
            <!-- App Links：直链 -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="user.edgecos.com" android:pathPrefix="/f/" />
            </intent-filter>
            <!-- Deep Link：OAuth 回调（自定义 scheme） -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="edgecos" android:host="oauth" android:pathPrefix="/callback" />
            </intent-filter>
        </activity>

        <!-- OAuth 登录页（原生 Activity 承载 WebView，解决滚动问题） -->
        <activity
            android:name=".feature.auth.OAuthLoginActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/Theme.EdgeCOS">
            <!-- OAuth 回调：QQ/支付宝等 App 授权完成后回调到此 -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="user.edgecos.com" android:pathPrefix="/oauth/callback" />
            </intent-filter>
            <!-- OAuth 回调：自定义 scheme -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="edgecos" android:host="oauth" android:pathPrefix="/callback" />
            </intent-filter>
        </activity>

        <!-- 崩溃兜底页：发生未捕获异常时由 CrashHandler 启动 -->
        <activity
            android:name=".crash.CrashActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:finishOnTaskLaunch="true"
            android:launchMode="singleInstance"
            android:theme="@style/Theme.EdgeCOS" />

        <!-- 上传服务（前台服务，数据同步类型） -->
        <service
            android:name="com.edgecos.mobileapp.upload.UploadService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- 下载服务（前台服务，数据同步类型；Android 16 Live Updates 通知） -->
        <service
            android:name="com.edgecos.mobileapp.feature.transfer.DownloadService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- FileProvider：用于分享文件给第三方应用 -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>
